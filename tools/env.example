# Copy to tools/.env and fill in. Never commit tools/.env.

# Firebase console > Project settings > your Android app > App ID
FIREBASE_APP_ID=1:1234567890:android:abcdef123456
# Tester group you create in Firebase App Distribution (put your own email in it)
FIREBASE_GROUPS=me

# Optional
# ANDROID_SERIAL=192.168.1.20:37123   # pin the Wi-Fi device if several are attached
# BUILD_MODE=release                  # release (default) | profile | debug
